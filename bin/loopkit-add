#!/bin/sh
# Copy one optional skill from the installed source; no network or model calls.
set -eu
usage() { printf 'Usage: loopkit-add <skill-name> [--force]\n'; }
SKILL=
FORCE=0
for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
    --force) FORCE=1 ;;
    -*) usage >&2; exit 2 ;;
    *) [ -z "$SKILL" ] || { usage >&2; exit 2; }; SKILL=$arg ;;
  esac
done
case "$SKILL" in ''|*[!a-z0-9-]*) usage >&2; exit 2 ;; esac
ROOT=$(node -e '
  const fs = require("node:fs");
  const path = require("node:path");
  console.log(path.dirname(path.dirname(fs.realpathSync(process.argv[1]))));
' "$0")
SRC=$ROOT/skills/$SKILL
DEST=.claude/skills/$SKILL
[ -f "$SRC/SKILL.md" ] || { printf 'Unknown skill: %s\n' "$SKILL" >&2; exit 1; }
for target in .claude .claude/skills "$DEST"; do
  [ ! -L "$target" ] || { printf 'Refusing symlink target: %s\n' "$target" >&2; exit 1; }
done
if [ -e "$DEST" ] && [ "$FORCE" != 1 ]; then
  printf '%s exists; --force explicitly overwrites\n' "$DEST" >&2
  exit 1
fi
if [ -d "$DEST" ] && [ -n "$(find "$DEST" -type l -print)" ]; then
  printf 'Refusing symlinks within %s\n' "$DEST" >&2
  exit 1
fi
mkdir -p "$DEST"
cp -R "$SRC/." "$DEST/"
printf 'Installed %s\n' "$DEST"
